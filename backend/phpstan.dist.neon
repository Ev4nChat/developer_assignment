parameters:
    level: max
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    ignoreErrors:
        - '#Property App\\Entity\\VacationRequest::\$id \(int\|null\) is never assigned int#'
        - '#Property App\\Entity\\User::\$id \(int\|null\) is never assigned int#'
